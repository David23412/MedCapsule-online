APP_NAME=MedCapsule
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example
APP_TIMEZONE=UTC

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medcapsule
DB_USERNAME=medcapsule
DB_PASSWORD=
DB_STRICT=true
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true

FORCE_HTTPS=true
TRUSTED_PROXIES=REMOTE_ADDR
TRUSTED_HOSTS=your-domain.example,*.your-domain.example
ENABLE_NGROK_COMPAT=false

CORS_ALLOWED_ORIGINS=https://your-domain.example
CORS_ALLOWED_ORIGIN_PATTERNS=

LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=warning

MAIL_MAILER=log

PAYMENT_CURRENCY=EGP
PAYMENT_AUTO_VERIFY=false
PAYMENT_PROVIDER=manual

PAYMOB_ENABLED=false
PAYMOB_MODE=live
PAYMOB_BASE_URL=https://accept.paymob.com
PAYMOB_PUBLIC_KEY=
PAYMOB_SECRET_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_IFRAME_ID=

VODAFONE_CASH_ENABLED=true
VODAFONE_CASH_NUMBER=
VODAFONE_CASH_NAME=MedCapsule
FAWRY_ENABLED=true
FAWRY_NUMBER=
FAWRY_NAME=MedCapsule
INSTAPAY_ENABLED=true
INSTAPAY_NUMBER=
INSTAPAY_USERNAME=
INSTAPAY_NAME=MedCapsule

BANK_TRANSFER_ENABLED=true
BANK_TRANSFER_BANK_NAME=
BANK_TRANSFER_ACCOUNT_NAME=
BANK_TRANSFER_IBAN=
BANK_TRANSFER_ACCOUNT_NUMBER=
BANK_TRANSFER_SWIFT=
BANK_TRANSFER_BRANCH=
BANK_TRANSFER_INSTRUCTIONS="Use your full name or order reference in the transfer note, then submit the transfer reference below."

QBANK_ENABLED=true
QBANK_MAX_FILE_SIZE=51200
QBANK_SUPPORTED_FORMATS=pdf,doc,docx,jpg,jpeg,png,tiff
