# BRUTAL MySQL Configuration - MAXIMUM PERFORMANCE MODE
# WARNING: This configuration prioritizes SPEED over safety
# Use only if you understand the implications

[mysql]
default-character-set = utf8mb4

[mysqld]
# 🔥 BRUTAL PERFORMANCE SETTINGS

# Memory allocation - AGGRESSIVE
innodb_buffer_pool_size = 2G          # Use 70-80% of available RAM
innodb_buffer_pool_instances = 8      # Multiple instances for concurrency
innodb_log_buffer_size = 64M          # Large log buffer
key_buffer_size = 512M                # MyISAM key buffer
table_open_cache = 4000               # Cache more table handles
table_definition_cache = 2000         # Cache table definitions

# Query cache - MAXIMUM
query_cache_type = 1                  # Enable query cache
query_cache_size = 256M               # Large query cache
query_cache_limit = 8M                # Cache larger queries

# Temporary tables - BRUTAL
tmp_table_size = 512M                 # Large temp tables in memory
max_heap_table_size = 512M            # Large heap tables

# InnoDB - EXTREME PERFORMANCE
innodb_flush_log_at_trx_commit = 2    # Faster commits (slight durability trade-off)
innodb_log_file_size = 512M           # Large log files
innodb_log_files_in_group = 2         # Multiple log files
innodb_write_io_threads = 8           # More write threads
innodb_read_io_threads = 8            # More read threads
innodb_thread_concurrency = 0         # No thread limit
innodb_file_per_table = 1             # Separate file per table
innodb_flush_method = O_DIRECT        # Direct I/O (Linux)
innodb_io_capacity = 2000             # High I/O capacity
innodb_io_capacity_max = 4000         # Maximum I/O capacity

# Connection handling - BRUTAL
max_connections = 500                 # More concurrent connections
max_connect_errors = 999999           # Don't block connections easily
connect_timeout = 10                  # Fast connection timeout
wait_timeout = 600                    # Connection timeout
interactive_timeout = 600             # Interactive timeout

# Thread handling - MAXIMUM
thread_cache_size = 100               # Cache more threads
thread_stack = 256K                   # Larger thread stack

# MyISAM optimizations
myisam_sort_buffer_size = 128M        # Large sort buffer
myisam_max_sort_file_size = 2G        # Large sort files

# Network - BRUTAL
max_allowed_packet = 64M              # Large packets
net_buffer_length = 32K               # Larger network buffer

# Sorting and grouping - AGGRESSIVE
sort_buffer_size = 4M                 # Large sort buffer per connection
read_buffer_size = 2M                 # Large read buffer
read_rnd_buffer_size = 4M             # Large random read buffer
join_buffer_size = 4M                 # Large join buffer

# Binary logging - MINIMAL (for performance)
expire_logs_days = 3                  # Keep logs for 3 days only
max_binlog_size = 100M                # Smaller binlog files
sync_binlog = 0                       # Don't sync binlog (faster, less safe)

# Slow query logging
slow_query_log = 1                    # Enable slow query log
long_query_time = 0.1                 # Log queries > 100ms
log_queries_not_using_indexes = 1     # Log non-indexed queries

# Skip reverse DNS lookups
skip-name-resolve                     # Faster connections

# Security optimizations
local-infile = 0                      # Disable local file loading

# Performance schema - MINIMAL
performance_schema = OFF              # Disable for maximum performance

# 🔥 BRUTAL OPTIMIZATIONS (USE WITH CAUTION)
# Skip external locking
skip-external-locking

# Disable DNS resolution
skip-host-cache

# Fast shutdown
innodb_fast_shutdown = 2              # Fastest shutdown (skip some cleanup)

# Adaptive hash index
innodb_adaptive_hash_index = ON       # Enable adaptive hash

# File format
innodb_file_format = Barracuda        # Modern file format

# Compression
innodb_compression_level = 6          # Medium compression

# 🔥 EXTREME MODE (ONLY FOR DEVELOPMENT/TESTING)
# Uncomment these ONLY if you want maximum speed with minimal safety

# innodb_doublewrite = 0              # Disable doublewrite (DANGEROUS)
# innodb_checksums = 0                # Disable checksums (DANGEROUS)
# sync_frm = 0                        # Don't sync .frm files (DANGEROUS)

[mysql_safe]
nice = 0

[mysqldump]
quick
quote-names
max_allowed_packet = 64M

[mysql]
no-auto-rehash

[isamchk]
key_buffer_size = 256M
sort_buffer_size = 256M
read_buffer = 2M
write_buffer = 2M