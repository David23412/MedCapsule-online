{
  "name": "e2e-testing-suite",
  "version": "1.0.0",
  "description": "Comprehensive E2E testing suite for bulletproofing user journeys",
  "main": "index.js",
  "scripts": {
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:ui": "playwright test --ui",
    "test:auth": "playwright test tests/e2e/user-authentication.spec.js",
    "test:enrollment": "playwright test tests/e2e/course-enrollment.spec.js",
    "test:quiz": "playwright test tests/e2e/quiz-functionality.spec.js",
    "test:payment": "playwright test tests/e2e/payment-flow.spec.js",
    "test:xp": "playwright test tests/e2e/xp-leaderboard.spec.js",
    "test:critical": "playwright test tests/e2e/user-authentication.spec.js tests/e2e/course-enrollment.spec.js tests/e2e/quiz-functionality.spec.js",
    "test:smoke": "playwright test --grep='@smoke'",
    "test:regression": "playwright test --grep='@regression'",
    "test:mobile": "playwright test --project=mobile-chrome --project=mobile-safari",
    "test:desktop": "playwright test --project=chromium-desktop --project=firefox-desktop --project=webkit-desktop",
    "test:accessibility": "playwright test --project=accessibility-testing",
    "test:performance": "playwright test --project=performance-desktop",
    "test:parallel": "playwright test --workers=4",
    "test:report": "playwright show-report",
    "test:install": "playwright install",
    "test:install-deps": "playwright install-deps",
    "test:codegen": "playwright codegen",
    "setup:test": "npm run test:install && npm run test:install-deps",
    "ci:test": "playwright test --reporter=junit --output-dir=test-results",
    "ci:test:sharded": "playwright test --shard=1/4",
    "clean:test": "rm -rf test-results playwright-report test-archives",
    "format:tests": "prettier --write 'tests/e2e/**/*.js'",
    "lint:tests": "eslint 'tests/e2e/**/*.js'"
  },
  "keywords": [
    "e2e",
    "testing",
    "playwright",
    "automation",
    "qa",
    "bulletproof",
    "user-journey"
  ],
  "author": "E2E Testing Team",
  "license": "MIT",
  "devDependencies": {
    "@babel/plugin-transform-runtime": "^7.28.0",
    "@babel/preset-env": "^7.28.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@types/node": "^20.8.0",
    "allure-playwright": "^2.9.0",
    "babel-jest": "^29.7.0",
    "cross-env": "^7.0.3",
    "dotenv": "^16.3.1",
    "eslint": "^8.50.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-playwright": "^0.18.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-html-reporters": "^3.1.7",
    "jest-junit": "^16.0.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.0.3"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "lodash": "^4.17.21",
    "moment": "^2.29.4"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "last 2 Chrome versions",
    "last 2 Firefox versions",
    "last 2 Safari versions",
    "last 2 Edge versions"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/e2e-testing-suite.git"
  },
  "bugs": {
    "url": "https://github.com/your-org/e2e-testing-suite/issues"
  },
  "homepage": "https://github.com/your-org/e2e-testing-suite#readme"
}
