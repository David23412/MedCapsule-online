APP_NAME=MedCapsule
APP_ENV=production
APP_KEY=base64:W9p2AMkQ7jVP4UGk3drpJaiyDJbwZrt0LJAAfX2pHa8=
APP_DEBUG=true
APP_URL=https://9eaf64809a96.ngrok-free.app

# Production Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medcapsule
DB_USERNAME=root
DB_PASSWORD=

# Production Session Configuration
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.ngrok.io
SESSION_SECURE=true

# Production Cache Configuration
CACHE_DRIVER=database
CACHE_PREFIX=medcapsule_cache_prod

# Production Security Settings
FORCE_HTTPS=true
SECURE_COOKIES=true
IS_PRODUCTION=true

# Mail Configuration (Production SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_EMAIL
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-production-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=300
PAYMENT_MAX_ATTEMPTS=3

# Notification Configuration
NOTIFICATION_SOUND_ENABLED=true
NOTIFICATION_POLLING_INTERVAL=30

# Production Logging
BROADCAST_DRIVER=log
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=single