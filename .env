APP_NAME=MedCapsule
APP_ENV=production
APP_KEY=base64:REPLACE_WITH_GENERATED_KEY
APP_DEBUG=false
APP_URL=https://your-production-domain.com

# Production Database Configuration
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medcapsule_production
DB_USERNAME=medcapsule_user
DB_PASSWORD=REPLACE_WITH_SECURE_PASSWORD

# Production Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.your-production-domain.com
SESSION_SECURE=true

# Production Cache Configuration
CACHE_DRIVER=database
CACHE_PREFIX=medcapsule_cache_prod

# Production Security Settings
FORCE_HTTPS=true
SECURE_COOKIES=true
IS_PRODUCTION=true

# Mail Configuration (Production SMTP)
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-email-provider.com
MAIL_PORT=587
MAIL_USERNAME=REPLACE_WITH_EMAIL
MAIL_PASSWORD=REPLACE_WITH_EMAIL_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-production-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=300
PAYMENT_MAX_ATTEMPTS=3

# Notification Configuration
NOTIFICATION_SOUND_ENABLED=true
NOTIFICATION_POLLING_INTERVAL=30

# Production Logging
BROADCAST_DRIVER=log
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=error
LOG_STACK=single