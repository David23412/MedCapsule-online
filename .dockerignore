##############################################################################
# MedCapsule — .dockerignore
# Exclude files from Docker build context to keep images lean & secure.
##############################################################################

# Git metadata
.git
.gitignore
.gitattributes

# Environment files — injected at runtime, never baked into the image
.env
.env.*

# Dependencies — installed fresh inside the image
node_modules/
vendor/

# Compiled frontend — built inside the image
public/build/
public/hot/

# Storage runtime data — mounted at runtime or created on startup
storage/logs/
storage/framework/cache/
storage/framework/sessions/
storage/framework/views/
storage/cache/
storage/audit/
storage/app/public/

# Bootstrap cache — generated by artisan cache commands at startup
bootstrap/cache/

# Tests
tests/
.phpunit.result.cache

# Development tools & artifacts
.playwright-cli/
output/
artifacts/
.kiro/
.vscode/
.idea/

# OS junk
.DS_Store
**/.DS_Store
Thumbs.db

# Personal planning
Task planner.md

# Documentation (not needed at runtime)
*.md
!README.md

# Shell deployment scripts (not needed in image)
scripts/*.sh
