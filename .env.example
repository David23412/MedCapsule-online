APP_NAME=MedCapsule
APP_ENV=local
APP_KEY=base64:YOUR_APP_KEY_HERE
APP_DEBUG=true
APP_URL=http://localhost:8000

# Database Configuration
DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=database/database.sqlite
DB_USERNAME=root
DB_PASSWORD=

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Cache Configuration
CACHE_DRIVER=database
CACHE_PREFIX=medcapsule_cache

# Mail Configuration
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-email@gmail.com
MAIL_FROM_NAME="${APP_NAME}"

# Payment Configuration
PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=300
PAYMENT_MAX_ATTEMPTS=3

# HTTPS Configuration (for ngrok/production)
FORCE_HTTPS=false
ASSET_URL=null
MIX_ASSET_URL=null

# Security Configuration
SECURE_COOKIES=false
SECURE_HEADERS=false

# Development vs Production flags
IS_PRODUCTION=false
ENABLE_QUERY_LOG=true
ENABLE_DEBUG_BAR=false

# Notification Configuration
NOTIFICATION_SOUND_ENABLED=true
NOTIFICATION_POLLING_INTERVAL=30

# Redis Configuration (optional)
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Queue Configuration
QUEUE_CONNECTION=sync

# Log Configuration
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# Broadcast Configuration
BROADCAST_DRIVER=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

# AWS Configuration (if using S3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Timezone Configuration
APP_TIMEZONE=UTC

# Locale Configuration
APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Maintenance Mode
MAINTENANCE_MODE=false

# Development URLs (for local development)
DEV_URL=http://localhost:8000
NGROK_URL=https://your-ngrok-subdomain.ngrok-free.dev

# Production URLs (for deployment)
PROD_URL=https://your-production-domain.com

# FREE QBANK Configuration (No Paid APIs Required!)
QBANK_ENABLED=true
QBANK_MAX_FILE_SIZE=51200  # 50MB in KB
QBANK_MAX_BATCH_FILES=10
QBANK_SUPPORTED_FORMATS=pdf,doc,docx,jpg,jpeg,png,tiff

# Tesseract OCR Configuration (FREE & LOCAL)
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng

# Ollama AI Configuration (FREE & LOCAL)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODELS=mistral,llama2,codellama,neural-chat

# Google Drive Integration (Generous Free Tier)
GOOGLE_DRIVE_QBANK_FOLDER=QBANK_Processed
GOOGLE_SERVICE_ACCOUNT_KEY_PATH=storage/app/google-service-account.json

# WhatsApp Integration (Twilio has Free Tier)
TWILIO_WHATSAPP_NUMBER=+1234567890
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token

# Local File Processing
QBANK_LOCAL_STORAGE=storage/app/qbank
QBANK_TEMP_DIR=sys_get_temp_dir()/qbank

# Alternative FREE OCR (Google Cloud Vision has free tier)
GOOGLE_CLOUD_VISION_ENABLED=false
GOOGLE_CLOUD_PROJECT_ID=your-project-id
GOOGLE_CLOUD_KEY_FILE_PATH=storage/app/google-cloud-key.json
