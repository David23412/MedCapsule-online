##############################################################################
# MedCapsule — Environment Template
# Copy this file to .env and fill in the values for your environment.
# NEVER commit .env to version control.
##############################################################################

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=MedCapsule
APP_ENV=production
# Generate with: php artisan key:generate --show
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.com
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# ── Database ──────────────────────────────────────────────────────────────────
# Set DB_CONNECTION to mysql or pgsql depending on your platform.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=medcapsule
DB_USERNAME=medcapsule_user
DB_PASSWORD=change_me
DB_STRICT=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ── Cache ─────────────────────────────────────────────────────────────────────
CACHE_STORE=redis
CACHE_PREFIX=medcapsule_cache

# Cache durations (minutes)
CACHE_COURSES_MINUTES=5
CACHE_TOPICS_MINUTES=5
CACHE_QUESTIONS_MINUTES=5
CACHE_USER_PROGRESS_MINUTES=1

# ── Session ───────────────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIES=true

# ── Queue ──────────────────────────────────────────────────────────────────────
# Use "database" for simple setups, "redis" for high-throughput.
QUEUE_CONNECTION=database

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Mail ──────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@your-domain.com
MAIL_FROM_NAME="${APP_NAME}"

# ── Security / Proxy ──────────────────────────────────────────────────────────
# Set to your platform's proxy IP range, or * for Render/Railway/Heroku.
TRUSTED_PROXIES=*
TRUSTED_HOSTS=your-domain.com
FORCE_HTTPS=true

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_CHANNEL=single
LOG_LEVEL=warning

# ── Broadcasting ──────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=log

# Reverb (self-hosted WebSockets) — only needed if using real-time features.
# REVERB_APP_ID=
# REVERB_APP_KEY=
# REVERB_APP_SECRET=
# REVERB_HOST=
# REVERB_PORT=443
# REVERB_SCHEME=https

# ── MedCapsule App Settings ───────────────────────────────────────────────────
QUIZ_TIMEOUT_MINUTES=30
QUIZ_DEFAULT_QUESTIONS=10
XP_PER_CORRECT_ANSWER=10
XP_PER_LEVEL=1000

NOTIFICATION_SOUND_ENABLED=true
NOTIFICATION_POLLING_INTERVAL=30

# ── Payment (Egyptian gateways) ───────────────────────────────────────────────
PAYMENT_ENABLED=true
PAYMENT_TIMEOUT=300
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_CURRENCY=EGP
PAYMENT_EXPIRY_HOURS=24
PAYMENT_AUTO_VERIFY=false
PAYMENT_VODAFONE_ENABLED=true
PAYMENT_VODAFONE_NUMBER=01012345678
PAYMENT_FAWRY_ENABLED=true
PAYMENT_INSTAPAY_ENABLED=true

# ── OCR / QBank ───────────────────────────────────────────────────────────────
QBANK_ENABLED=true
QBANK_MAX_FILE_SIZE=51200
QBANK_SUPPORTED_FORMATS=pdf,doc,docx,jpg,jpeg,png,tiff
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng
OCR_CONFIDENCE_THRESHOLD=80

# ── AWS S3 (optional — for file storage) ──────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_LOGIN=50,60
RATE_LIMIT_QUIZ_ATTEMPTS=100,60
RATE_LIMIT_PAYMENTS=50,60

# ── Quality Control ───────────────────────────────────────────────────────────
QUALITY_CONTROL_ENABLED=true
MINIMUM_QUALITY_SCORE=90
