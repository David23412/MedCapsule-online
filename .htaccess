# SECURITY: Block access to backup directories and sensitive files
<IfModule mod_rewrite.c>
    RewriteEngine On

    # FORCE HTTPS REDIRECT for ngrok and development
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^(.+\.(ngrok-free\.app|ngrok\.io))$ [NC,OR]
    RewriteCond %{HTTP_HOST} ^localhost(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

    # FORCE HTTPS REDIRECT for IP addresses (development)
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+(:[0-9]+)?$ [NC]
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Block access to backup directories
    RewriteRule ^backup-payment/.*$ - [F,L]
    RewriteRule ^backups/.*$ - [F,L]
    
    # Block access to sensitive files
    RewriteRule \.(bak|backup|old|tmp|log|env|git|gitignore|htaccess|htpasswd)$ - [F,L]
    
    # Block access to configuration files
    RewriteRule ^(config|storage|bootstrap|database|tests|vendor)/ - [F,L]
    
    # Block access to Laravel specific files
    RewriteRule ^(artisan|composer\.(json|lock)|package\.(json|lock)|\.env.*|phpunit\.xml|webpack\.mix\.js)$ - [F,L]
</IfModule>

# Block access to backup directories with Apache directives
<Directory "backup-payment">
    Require all denied
</Directory>

<Directory "backups">
    Require all denied
</Directory>

# Block access to sensitive file types
<FilesMatch "\.(bak|backup|old|tmp|log|env|git|gitignore|htaccess|htpasswd)$">
    Require all denied
</FilesMatch>

# Security headers
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options nosniff
    Header always set X-Frame-Options SAMEORIGIN
    Header always set X-XSS-Protection "1; mode=block"
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Content-Security-Policy "default-src 'self' https: blob: data: https://*.ngrok.io https://*.ngrok-free.app http://localhost:8000 https://localhost:8000 ws://localhost:443 wss://localhost:443; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000 https://cdn.jsdelivr.net https://code.jquery.com https://cdnjs.cloudflare.com ws://localhost:443 wss://localhost:443; style-src 'self' 'unsafe-inline' https: data: blob: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000 https://cdn.jsdelivr.net https://fonts.googleapis.com https://cdnjs.cloudflare.com https://fonts.gstatic.com; img-src 'self' https: data: blob: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000; font-src 'self' https: blob: data: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000 https://fonts.googleapis.com https://cdnjs.cloudflare.com https://fonts.gstatic.com https://cdn.jsdelivr.net; connect-src 'self' https: wss: ws: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000 http://localhost:443 https://localhost:443 ws://localhost:443 wss://localhost:443 https://fonts.googleapis.com https://fonts.gstatic.com https://cdn.jsdelivr.net https://cdnjs.cloudflare.com; worker-src 'self' https: blob: https://*.ngrok.io https://*.ngrok-free.app https://2927d6cb2150.ngrok-free.app http://localhost:8000 https://localhost:8000 http://localhost:443 https://localhost:443 ws://localhost:443 wss://localhost:443; frame-ancestors 'none'"
</IfModule>
