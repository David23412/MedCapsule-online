APP_NAME=MedCapsule
APP_ENV=production
APP_KEY=base64:wpgF9FCAdIQRDTDbJAA8QJSa+Nndw0nputPMm0KnxpQ=
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://medcapsule-online-production.up.railway.app

# Database - Railway auto-configured
DB_CONNECTION=mysql
DB_STRICT=false
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# Cache - Redis plugin
CACHE_STORE=redis

# Session Configuration
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SAME_SITE=lax
SESSION_SECURE_COOKIES=true

# Security
FORCE_HTTPS=true
TRUSTED_PROXIES=*
TRUSTED_HOSTS=*.railway.app,*.railwayapp.com

# Broadcasting (disabled for production)
BROADCAST_CONNECTION=log

# Queue (disabled for production)
QUEUE_CONNECTION=log

# Mail Configuration
MAIL_MAILER=log

# Performance & Monitoring (lightweight)
PERFORMANCE_MONITORING=false
QUERY_LOGGING=false
HEALTH_CHECKS=true
ERROR_REPORTING=false

# MedCapsule Specific Configuration
QUIZ_TIMEOUT_MINUTES=30
QUIZ_DEFAULT_QUESTIONS=10
XP_PER_CORRECT_ANSWER=10
XP_PER_LEVEL=1000

# Payment Configuration (simplified for free courses)
PAYMENT_CURRENCY=EGP
PAYMENT_VODAFONE_ENABLED=true
PAYMENT_VODAFONE_NUMBER=01012345678
PAYMENT_FAWRY_ENABLED=true
PAYMENT_INSTAPAY_ENABLED=true
PAYMENT_AUTO_VERIFY=false
PAYMENT_EXPIRY_HOURS=24

# Security Settings
RATE_LIMIT_QUIZ_ATTEMPTS=100,60
RATE_LIMIT_PAYMENTS=50,60
RATE_LIMIT_LOGIN=50,60
SESSION_TIMEOUT=120
UPLOAD_MAX_SIZE_MB=10

# Cache Durations
CACHE_COURSES_MINUTES=5
CACHE_TOPICS_MINUTES=5
CACHE_QUESTIONS_MINUTES=5
CACHE_USER_PROGRESS_MINUTES=1

# Disable advanced features for production
ANALYTICS_TRACK_ACTIVITY=false
ANALYTICS_TRACK_PERFORMANCE=false

# QBANK Configuration (minimal)
QBANK_ENABLED=true
QBANK_MAX_FILE_SIZE=51200
QBANK_SUPPORTED_FORMATS=pdf,doc,docx,jpg,jpeg,png,tiff

# Local AI disabled for production
OLLAMA_URL=
OLLAMA_MODELS=

# Tesseract OCR
TESSERACT_PATH=/usr/bin/tesseract
TESSERACT_LANG=eng
OCR_CONFIDENCE_THRESHOLD=80

# Quality Control (simplified)
QUALITY_CONTROL_ENABLED=true
MINIMUM_QUALITY_SCORE=90

# Logging
LOG_CHANNEL=single
LOG_LEVEL=warning
